#include <stdio.h>

int min(int a, int b) {
    return (a < b) ? a : b;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    int size = 2 * n - 1;
    
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            // Find the minimum distance to the top, left, bottom, or right edge
            int min_dist = min(min(i, j), min(size - 1 - i, size - 1 - j));
            
            // Print the value followed by a space
            printf("%d ", n - min_dist);
        }
        printf("\n");
    }
    return 0;
}
