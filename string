#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    // Allocate buffer for maximum length (1000 characters + null terminator)
    char *s = malloc(1001 * sizeof(char));
    
    // Read the string from standard input
    if (scanf("%1000s", s) != 1) {
        free(s);
        return 0;
    }
    
    // Initialise an array of size 10 with zeros to store counts for digits 0-9
    int frequency[10] = {0};
    
    // Iterate through the string until the null terminator
    for (int i = 0; s[i] != '\0'; i++) {
        // Check if the character is a digit
        if (s[i] >= '0' && s[i] <= '9') {
            // Convert character to integer index by subtracting ASCII value of '0'
            frequency[s[i] - '0']++;
        }
    }
    
    // Print the frequencies separated by spaces
    for (int i = 0; i < 10; i++) {
        printf("%d ", frequency[i]);
    }
    printf("\n");
    
    // Free the dynamically allocated memory
    free(s);
    
    return 0;
}
